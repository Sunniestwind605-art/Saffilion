{
  "name": "saffilion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:build": "node scripts/expand-snapshots.mjs && node scripts/generate-questions.mjs",
    "data:generate-questions": "node scripts/generate-questions.mjs",
    "data:report": "node scripts/generate-questions.mjs && node scripts/validate-bank.mjs",
    "data:validate": "node scripts/validate-bank.mjs",
    "validate:data": "node scripts/validate-bank.mjs && vitest run src/data/questions.test.ts",
    "validate:questions": "node scripts/validate-bank.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
